type token =
    WHILE
  | TINT
  | STAR
  | SEMI
  | RP
  | RETURN
  | REM
  | RB
  | PRINT
  | PLUS
  | OR
  | NOT
  | NEQS
  | NEQ
  | MINUS
  | LT
  | LP
  | LE
  | LB
  | IF
  | IDENT of string
  | GT
  | GE
  | EQS
  | EQ
  | EOF
  | END
  | ELSE
  | DIV
  | CST of int
  | CONTINUE
  | COMMA
  | BREAK
  | BEGIN
  | AND
  | AFFECT
  | ADDRESS
val menhir_begin_marker : int
val xv_stmt : AST1.stmt
val xv_seq : AST1.seq
val xv_prog : AST1.program
val xv_params : AST1.params
val xv_op : AST1.binop
val xv_list_gdef : AST1.program
val xv_gdef : AST1.gdef
val xv_expr : AST1.expr
val xv_arg_list : AST1.expr list
val menhir_end_marker : int

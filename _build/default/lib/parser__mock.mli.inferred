type token =
    WHILE
  | TVOID
  | TINT
  | TBOOL
  | SEMI
  | RP
  | RETURN
  | REM
  | RB
  | PRINT
  | PLUS
  | NOT
  | NEQS
  | NEQ
  | MUL
  | MINUS
  | LT
  | LP
  | LE
  | LB
  | IF
  | IDENT of string
  | GT
  | GE
  | EQS
  | EQ
  | EOF
  | ELSE
  | DIV
  | CST of int
  | COMA
  | AFFECT
val menhir_begin_marker : int
val xv_prog : Types.expr
val xv_op : Types.binop
val xv_expr : Types.expr
val menhir_end_marker : int
